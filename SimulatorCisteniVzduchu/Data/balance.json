// Vyvážení hry. Tenhle soubor můžeš upravovat bez sahání do kódu –
// stačí hru znovu spustit (komentáře jako tento jsou povolené).
{
  // Kolik procent kyslíku je v atmosféře na začátku (ve skutečnosti ~21 %).
  "startOxygen": 21,

  // Kolik smogu celkem musí hráč vyčistit, aby kyslík dosáhl 100 % a hra skončila.
  "smogToWin": 3000000,

  // O kolik se zdraží každý další kus stejného vylepšení (1.15 = o 15 %).
  "costGrowth": 1.15,

  // Továrny záporáka (začne je stavět, až to řekne příběh – viz story.json).
  "factories": {
    // Za kolik sekund postaví další továrnu: na začátku hry / těsně před koncem.
    "spawnIntervalStart": 45,
    "spawnIntervalEnd": 18,
    // Kolik továren může stát najednou.
    "maxCount": 4,
    // Každá továrna znečišťuje tolik procent z hráčova čištění za sekundu (0.25 = 25 %),
    // ale vždy aspoň tolik, aby stáhla "minOxygenDrain" procentních bodů kyslíku za sekundu
    // (0.01 = 0,6 % kyslíku za minutu na jednu továrnu, 4 továrny = 2,4 % za minutu).
    "pollutionFraction": 0.25,
    "minOxygenDrain": 0.01,
    // Kolikrát se musí na továrnu kliknout: základ + přírůstek za každou dříve postavenou,
    // ale nejvýš "maxHealth".
    "baseHealth": 12,
    "healthGrowth": 2,
    "maxHealth": 40,
    // Odměna za zničení = tolik sekund hráčova čištění (aspoň 25 smogu).
    "bountySeconds": 20
  },

  // Seznam vylepšení v obchodě (v tomhle pořadí).
  //   perClick  = kolik smogu navíc dává každé kliknutí na kytku
  //   perSecond = kolik smogu za sekundu čistí automaticky
  "upgrades": [
    { "id": "hnojivo",   "name": "Hnojivo",              "description": "Kytka čistí víc za klik",     "baseCost": 15,     "perClick": 1,  "perSecond": 0 },
    { "id": "strom",     "name": "Strom",                "description": "Pomalu, ale sám čistí",       "baseCost": 50,     "perClick": 0,  "perSecond": 1 },
    { "id": "vcely",     "name": "Včelí úl",             "description": "Včely opylují další kytky",   "baseCost": 400,    "perClick": 0,  "perSecond": 6 },
    { "id": "rukavice",  "name": "Zahradnické rukavice", "description": "Pořádný úchop = pořádný klik","baseCost": 2000,   "perClick": 10, "perSecond": 0 },
    { "id": "robot",     "name": "Robotí zahradník",     "description": "Sází kytky ve dne v noci",    "baseCost": 3000,   "perClick": 0,  "perSecond": 35 },
    { "id": "sklenik",   "name": "Skleník",              "description": "Celá továrna na kyslík",      "baseCost": 25000,  "perClick": 0,  "perSecond": 200 },
    { "id": "dron",      "name": "Dron s filtrem",       "description": "Vysává smog přímo z mraků",   "baseCost": 200000, "perClick": 0,  "perSecond": 1200 }
  ]
}
